# Copy to .env and `export $(cat .env | xargs)` or use your process manager.
PORT=3000
# REQUIRED in production (NODE_ENV=production refuses to start without it)
JWT_SECRET=change-me-to-64-random-hex-chars
# Comma-separated extra origins allowed to open the WebSocket (same host is always allowed)
ALLOWED_ORIGINS=
# Public IP (or DNS name) that browsers can reach for media. Needed on LAN/cloud.
MEDIASOUP_ANNOUNCED_IP=
# UDP/TCP port range for WebRTC transports — open these in your firewall
RTC_MIN_PORT=40000
RTC_MAX_PORT=40100
# MEDIASOUP_WORKERS=4
# MEDIA_ENABLED=true
# LOG_LEVEL=info
